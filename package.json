{
  "name": "ticketmaster-clone",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
    "build": "pnpm --filter api build && pnpm --filter web build",
    "test": "vitest run --config vitest.config.ts",
    "e2e": "playwright test --config playwright.config.cjs",
    "db:seed": "pnpm --filter api db:seed",
    "prisma": "pnpm --filter api prisma"
  },
  "devDependencies": {
    "@playwright/test": "1.42.1",
    "@prisma/client": "5.10.2",
    "concurrently": "^8.2.2",
    "vitest": "1.3.1"
  },
  "engines": {
    "node": ">=20.11.1",
    "pnpm": ">=8.15.4"
  }
}
